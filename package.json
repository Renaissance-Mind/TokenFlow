{
  "name": "@renaissancemind/tokenflow",
  "version": "0.2.83",
  "description": "Local token usage collector for multi-device AI agent accounting.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renaissance-Mind/TokenFlow.git"
  },
  "type": "module",
  "tokenflow": {
    "desktopProtocol": 2,
    "backgroundCollector": 1
  },
  "bin": {
    "tokenflow": "dist/cli.js",
    "tokenusage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/assets/teaser_en.png",
    "docs/assets/teaser_zh.png",
    "docs/assets/tokenflow.svg",
    "docs/i18n"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "fzstd": "0.1.1",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "1.9.1"
  }
}
