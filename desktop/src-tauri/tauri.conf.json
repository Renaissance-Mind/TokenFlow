{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenFlow",
  "version": "0.2.0",
  "identifier": "ai.renaissancemind.tokenflow",
  "build": {
    "frontendDist": "../renderer",
    "beforeBuildCommand": "node scripts/build.mjs",
    "beforeDevCommand": "node scripts/build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "local"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tokenflow-collector"
    ],
    "resources": [
      "../../THIRD_PARTY_NOTICES.md"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "../assets/entitlements.mac.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RUY3NEY3REU3QUQ0MUIKUldRYjFIcmU5M1R2ZDAwWm83c0JKSkFFaVN0MWp6cy96KzFKOGtWRG95Wk02QmRLMDJMVHhtZ2MK"
    }
  }
}
