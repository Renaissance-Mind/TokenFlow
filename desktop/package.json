{
  "name": "tokenflow-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "TokenFlow dashboard and bundled local usage collector",
  "author": "RenaissanceMind",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tauri dev",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "tauri build --no-bundle",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
