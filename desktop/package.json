{
  "name": "tokenflow-desktop",
  "version": "0.1.22",
  "private": true,
  "description": "TokenFlow dashboard and bundled local usage collector",
  "author": "RenaissanceMind",
  "license": "Apache-2.0",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "build": "npm --prefix .. run build && tsc -p tsconfig.json && node scripts/prepare-resources.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.19.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "extract-zip": "2.0.1",
    "js-yaml": "4.3.2",
    "npm": "10.9.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
